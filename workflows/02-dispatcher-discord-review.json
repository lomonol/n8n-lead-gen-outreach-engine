    {
      "id": "wf2-check-killswitch",
      "name": "Check Shared Kill-Switch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        400
      ],
      "continueOnFail": true,
      "parameters": {
