      "position": [
        1020,
        880
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Collapses the suppression list and today's send count into one item, and stops the run when the shared daily cap is reached.\nconst DAILY_CAP_TOTAL = 10; // first touches + follow-ups combined, one Gmail account\nconst supp = $('Fetch Suppression List').all().map(i => i.json).filter(j => j && j.id);\nconst domains = new Set();\nfor (const r of supp) {\n  const f = r.fields || r;\n  const d = String(f.Domain || '').toLowerCase().trim();\n  if (d) domains.add(d);\n}\nconst sendsToday = $input.all().filter(i => i.json && i.json.id).length;\nif (sendsToday >= DAILY_CAP_TOTAL) return []; // shared cap reached: nothing sends this cycle\nreturn [{ json: { suppressed_domains: [...domains], sends_today_total: sendsToday, daily_cap_total: DAILY_CAP_TOTAL } }];\n"
      }
    }
