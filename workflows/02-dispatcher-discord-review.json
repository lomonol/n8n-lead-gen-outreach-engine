    {
      "id": "wf2-dispatcher-preflight",
      "name": "Dispatcher Pre-Flight Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        400
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// 1. Check Shared Kill-Switch state from outreach_discord_bot\nlet killSwitch = {};\ntry {\n  killSwitch = $('Check Shared Kill-Switch').first()?.json || {};\n} catch (e) {\n  killSwitch = {};\n}\n\n// Fail-closed security check: only proceed if kill-switch is explicitly reachable and is_paused is strictly false\nif (killSwitch.is_paused !== false) {\n  // Dispatcher safely halted (paused, unreachable, or in error state)\n  return [];\n}\n\n// 2. Track daily send count (starts at 6/day for clean warm-up)\nconst staticData = $getWorkflowStaticData('global');\nconst today = new Date().toISOString().slice(0, 10);\nif (staticData.sendDate !== today) {\n  staticData.sendDate = today;\n  staticData.sendsToday = 0;\n  staticData.lastSendTime = 0;\n}\n\nconst maxSendsPerDay = 6; // Week 1 safe ramp-up cap: 6 emails/day\nif (staticData.sendsToday >= maxSendsPerDay) {\n  return []; // Daily quota reached\n}\n\n// 3. Randomized Human Delay (35 to 75 minutes between dispatches)\nconst minGapMs = (35 + Math.random() * 40) * 60 * 1000;\nconst timeSinceLastSend = Date.now() - (staticData.lastSendTime || 0);\n\nif (staticData.sendsToday > 0 && timeSinceLastSend < minGapMs) {\n  return []; // Wait for natural human interval\n}\n\nreturn [{\n  json: {\n    proceed: true,\n    sends_today: staticData.sendsToday,\n    max_sends: maxSendsPerDay\n  }\n}];"
      }
    },
    {
      "id": "wf2-fetch-top-draft",
