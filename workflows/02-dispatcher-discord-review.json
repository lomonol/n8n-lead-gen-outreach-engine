        "limit": 5,
        "filterByFormula": "AND(OR({Review Status} = 'Ready to Send', {Review Status} = 'Ready to Send (Tier B Standby)'), {Sent At} = BLANK(), {Company} != '')",
        "sort": {
          "property": [
            {
              "field": "Send Priority",
              "direction": "desc"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
