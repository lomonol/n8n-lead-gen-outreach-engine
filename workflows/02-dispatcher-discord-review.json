{
  "name": "Autonomous Outreach Dispatcher & 1-Click Discord Review",
  "nodes": [
    {
      "id": "wf2-webhook-trigger",
      "name": "1-Click Review Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "path": "review-lead",
        "httpMethod": "GET",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "wf2-process-review",
      "name": "Process Review Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const query = $input.first().json.query || {};\nconst draftId = query.id;\nconst action = (query.action || '').toLowerCase().trim();\n\nif (!draftId) {\n  return [{ json: { success: false, message: 'Missing draft ID parameter.' } }];\n}\n\nreturn [{\n  json: {\n    draft_id: draftId,\n    action: action,\n    is_approve: action === 'approve',\n    is_reject: action === 'reject',\n    review_status: action === 'approve' ? 'Ready to Send' : 'Rejected'\n  }\n}];"
      }
    },
    {
      "id": "wf2-if-approve",
      "name": "If: Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-approve",
              "leftValue": "={{ $json.is_approve }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "wf2-airtable-update-draft-approve",
      "name": "Update Draft to Ready to Send",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        1080,
        200
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "appYOUR_BASE_ID",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblYOUR_TABLE_ID",
          "mode": "list"
        },
        "id": "={{ $('Process Review Action').item.json.draft_id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Review Status": "Ready to Send"
          }
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_ME",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "wf2-respond-approved",
      "name": "Respond Approved HTML",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        },
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Draft Approved</title>\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0b0f19; color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }\n    .card { background: #131b2e; border: 1px solid #1e293b; border-radius: 16px; padding: 40px; text-align: center; max-width: 440px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }\n    .badge { display: inline-block; background: #064e3b; color: #34d399; font-weight: 600; font-size: 13px; padding: 4px 12px; border-radius: 9999px; margin-bottom: 16px; border: 1px solid #059669; }\n    h2 { margin: 0 0 12px 0; color: #ffffff; font-size: 24px; font-weight: 700; }\n    p { margin: 0 0 24px 0; color: #94a3b8; font-size: 15px; line-height: 1.6; }\n    .close-hint { font-size: 13px; color: #64748b; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"badge\">Approved & Queued</div>\n    <h2>✅ Lead Approved!</h2>\n    <p>This draft is now marked <strong>Ready to Send</strong> in your Airtable priority queue. The scheduled dispatcher will pick it up on its next business-hours cycle.</p>\n    <div class=\"close-hint\">You can safely close this tab and return to Discord.</div>\n  </div>\n</body>\n</html>"
      }
    },
    {
      "id": "wf2-airtable-update-draft-reject",
      "name": "Update Draft to Rejected",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        1080,
        420
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "appYOUR_BASE_ID",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblYOUR_TABLE_ID",
          "mode": "list"
        },
        "id": "={{ $('Process Review Action').item.json.draft_id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Review Status": "Rejected"
          }
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_ME",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "wf2-respond-rejected",
      "name": "Respond Rejected HTML",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        },
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Draft Rejected</title>\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0b0f19; color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }\n    .card { background: #131b2e; border: 1px solid #1e293b; border-radius: 16px; padding: 40px; text-align: center; max-width: 440px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }\n    .badge { display: inline-block; background: #450a0a; color: #f87171; font-weight: 600; font-size: 13px; padding: 4px 12px; border-radius: 9999px; margin-bottom: 16px; border: 1px solid #991b1b; }\n    h2 { margin: 0 0 12px 0; color: #ffffff; font-size: 24px; font-weight: 700; }\n    p { margin: 0 0 24px 0; color: #94a3b8; font-size: 15px; line-height: 1.6; }\n    .close-hint { font-size: 13px; color: #64748b; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"badge\">Rejected & Excluded</div>\n    <h2>❌ Lead Rejected</h2>\n    <p>This draft has been discarded and marked as <strong>Rejected</strong>. It will not be sent, and no follow-ups will be generated.</p>\n    <div class=\"close-hint\">You can safely close this tab and return to Discord.</div>\n  </div>\n</body>\n</html>"
      }
    },
    {
      "id": "wf2-schedule-dispatcher",
      "name": "Every 25 Mins (Dispatcher)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        400,
        700
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 25
            }
          ]
        }
      }
    },
    {
      "id": "wf2-dispatcher-preflight",
      "name": "Dispatcher Pre-Flight Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        700
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\n// 1. Check Circuit Breaker / Kill Switch\nif (staticData.isPaused || staticData.killSwitchActive) {\n  return []; // Halted due to bounce or manual pause\n}\n\n// 2. Track daily send count (starts at 5-10/day)\nconst today = new Date().toISOString().slice(0, 10);\nif (staticData.sendDate !== today) {\n  staticData.sendDate = today;\n  staticData.sendsToday = 0;\n}\n\nconst maxSendsPerDay = 10; // Ramp-up cap: 5-10/day\nif (staticData.sendsToday >= maxSendsPerDay) {\n  return []; // Daily quota reached\n}\n\n// 3. Operating Days: Monday to Friday\nconst dayOfWeek = new Date().getUTCDay(); // 0 is Sunday, 6 is Saturday\nif (dayOfWeek === 0 || dayOfWeek === 6) {\n  return []; // Do not send on weekends\n}\n\nreturn [{\n  json: {\n    proceed: true,\n    sends_today: staticData.sendsToday,\n    max_sends: maxSendsPerDay\n  }\n}];"
      }
    },
    {
      "id": "wf2-fetch-top-draft",
      "name": "Fetch Top Priority Draft",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        840,
        700
      ],
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "appYOUR_BASE_ID",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblYOUR_TABLE_ID",
          "mode": "list"
        },
        "returnAll": false,
        "limit": 1,
        "filterByFormula": "AND({Review Status} = 'Ready to Send', {Sent At} = BLANK())",
        "sort": {
          "property": [
            {
              "field": "Send Priority",
              "direction": "desc"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_ME",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "wf2-if-has-draft",
      "name": "If: Has Draft Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1080,
        700
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-has-draft",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "wf2-fetch-company-details",
      "name": "Fetch Recipient Company",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        1320,
        680
      ],
      "parameters": {
        "operation": "get",
        "base": {
          "__rl": true,
          "value": "appYOUR_BASE_ID",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblYOUR_TABLE_ID",
          "mode": "list"
        },
        "id": "={{ $('Fetch Top Priority Draft').item.json.fields.Company ? $('Fetch Top Priority Draft').item.json.fields.Company[0] : '' }}"
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_ME",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "wf2-send-email-placeholder",
      "name": "Send Outreach Email (Gmail / SMTP)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        680
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// PLACEHOLDER: Ready to be connected to Gmail node or SMTP node\nconst draft = $('Fetch Top Priority Draft').item.json.fields || {};\nconst company = $json.fields || {};\nconst recipientEmail = company.Email || draft.Domain;\nconst subject = draft.Subject || 'quick workflow note';\nconst body = draft.email_1 || '';\n\n// Will send via dedicated Gmail / SMTP when user credentials are provided\nreturn [{\n  json: {\n    status: 'READY_TO_DISPATCH',\n    recipient: recipientEmail,\n    subject: subject,\n    body: body,\n    draft_id: $('Fetch Top Priority Draft').item.json.id,\n    company_id: $json.id\n  }\n}];"
      }
    },
    {
      "id": "wf2-update-draft-sent",
      "name": "Update Draft as Sent",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        1800,
        680
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "appYOUR_BASE_ID",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblYOUR_TABLE_ID",
          "mode": "list"
        },
        "id": "={{ $('Send Outreach Email (Gmail / SMTP)').item.json.draft_id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Review Status": "Sent",
            "Sent At": "={{ new Date().toISOString() }}"
          }
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_ME",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "wf2-update-company-sent",
      "name": "Update Company as Sent",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        2020,
        680
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "appYOUR_BASE_ID",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "tblYOUR_TABLE_ID",
          "mode": "list"
        },
        "id": "={{ $('Send Outreach Email (Gmail / SMTP)').item.json.company_id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Review Status": "Sent",
            "Sent At": "={{ new Date().toISOString() }}"
          }
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_ME",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "id": "wf2-increment-counter",
      "name": "Increment Daily Send Counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        680
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.sendsToday = (staticData.sendsToday || 0) + 1;\nreturn [{\n  json: {\n    status: 'DISPATCH_LOGGED',\n    sends_today: staticData.sendsToday\n  }\n}];"
      }
    }
  ],
  "connections": {
    "1-Click Review Webhook": {
      "main": [
        [
          {
            "node": "Process Review Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Review Action": {
      "main": [
        [
          {
            "node": "If: Is Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If: Is Approved?": {
      "main": [
        [
          {
            "node": "Update Draft to Ready to Send",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Update Draft to Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Draft to Ready to Send": {
      "main": [
        [
          {
            "node": "Respond Approved HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Draft to Rejected": {
      "main": [
        [
          {
            "node": "Respond Rejected HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 25 Mins (Dispatcher)": {
      "main": [
        [
          {
            "node": "Dispatcher Pre-Flight Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatcher Pre-Flight Gate": {
      "main": [
        [
          {
            "node": "Fetch Top Priority Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Top Priority Draft": {
      "main": [
        [
          {
            "node": "If: Has Draft Ready?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If: Has Draft Ready?": {
      "main": [
        [
          {
            "node": "Fetch Recipient Company",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recipient Company": {
      "main": [
        [
          {
            "node": "Send Outreach Email (Gmail / SMTP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Outreach Email (Gmail / SMTP)": {
      "main": [
        [
          {
            "node": "Update Draft as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Draft as Sent": {
      "main": [
        [
          {
            "node": "Update Company as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Company as Sent": {
      "main": [
        [
          {
            "node": "Increment Daily Send Counter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
